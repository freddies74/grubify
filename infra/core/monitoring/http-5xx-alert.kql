let MinRequests = __MIN_REQUEST_VOLUME__;
let MinErrorRate = todouble(__MIN_ERROR_RATE_PERCENT__) / 100.0;
union isfuzzy=true
(
    AppRequests
    | project resultCode = tostring(ResultCode)
),
(
    requests
    | project resultCode = tostring(resultCode)
)
| summarize TotalRequests = count(), FiveXXCount = countif(resultCode startswith "5")
| extend ErrorRate = iif(TotalRequests == 0, 0.0, todouble(FiveXXCount) / todouble(TotalRequests))
| where FiveXXCount >= __MIN_5XX_COUNT__
| where TotalRequests >= MinRequests
| where ErrorRate >= MinErrorRate
| project AlertHit = 1
